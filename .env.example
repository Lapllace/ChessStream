# ─── CHESS.COM ─────────────────────────────────────────────
# Nick do streamer no Chess.com (usado para polling de partidas)
CHESS_STREAMER_NICK=seu_nick_aqui

# ─── TWITCH ─────────────────────────────────────────────────
TWITCH_USERNAME=nome_do_bot_twitch
TWITCH_OAUTH_TOKEN=oauth:xxxxxxxxxxxxxxxxxxxxxxxxxx
# Token gerado em: https://twitchapps.com/tmi/
TWITCH_CHANNEL=canal_do_streamer

# ─── YOUTUBE ────────────────────────────────────────────────
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxx
# Live Chat ID (pegar via API quando a live começa)
YOUTUBE_LIVE_CHAT_ID=

# ─── YOUTUBE (Google OAuth) ─────────────────────────────────
# As credenciais OAuth do Google ficam em:
#   assets/google-oauth-credentials.json
# Baixe o JSON em: Google Cloud Console > Credenciais > seu app >
# "Fazer download do JSON"
# Esse arquivo NÃO vai para o Git (está no .gitignore).

# ─── SUPABASE (Opção B) ─────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── MERCADO PAGO (Opção B) ─────────────────────────────────
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxx
MP_WEBHOOK_SECRET=sua_chave_secreta_aqui
# Valor mínimo em centavos para entrar na fila VIP (ex: 500 = R$5,00)
MP_MIN_VALUE_CENTS=500
