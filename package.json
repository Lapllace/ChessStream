{
  "name": "chessstream-hub",
  "version": "1.0.0",
  "description": "Bot de gerenciamento de fila para streamers de xadrez",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "build": "electron-builder",
    "build:electron": "electron-builder"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "axios": "^1.6.0",
    "dotenv": "^16.6.1",
    "electron-store": "^11.0.2",
    "googleapis": "^178.0.0",
    "tmi.js": "^1.8.5",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.chessstream.hub",
    "productName": "ChessStream Hub",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
