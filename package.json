{
  "name": "chessstream-hub",
  "version": "1.0.0",
  "description": "Bot de gerenciamento de fila para streamers de xadrez",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "build": "electron-builder",
    "build:electron": "electron-builder"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.109.0",
    "axios": "^1.6.0",
    "dotenv": "^16.4.0",
    "electron-store": "^7.0.0",
    "install": "^0.13.0",
    "tmi.js": "^1.8.5"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  },
  "build": {
    "appId": "com.chessstream.hub",
    "productName": "ChessStream Hub",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
