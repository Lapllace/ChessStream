# ── Vercel → Supabase ────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role: usada só no servidor, ignora RLS. NUNCA exponha no app.
SUPABASE_SERVICE_KEY=eyJ...

# ── LivePix OAuth (painel de desenvolvedores) ────────────────────
LIVEPIX_CLIENT_ID=
LIVEPIX_CLIENT_SECRET=
# Escopo necessário para ler mensagens/donates
LIVEPIX_OAUTH_SCOPE=messages:read

# Segredo compartilhado do webhook. Configure a URL do webhook como:
# https://seu-projeto.vercel.app/api/livepix?secret=SEU_SEGREDO
LIVEPIX_WEBHOOK_SECRET=
