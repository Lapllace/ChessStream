# ── Vercel → Supabase ────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role: usada só no servidor, ignora RLS. NUNCA exponha no app.
# A integração Supabase da Vercel costuma criar SUPABASE_SERVICE_ROLE_KEY.
# O código aceita SUPABASE_SERVICE_ROLE_KEY ou SUPABASE_SERVICE_KEY.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── LivePix (SaaS / multi-streamer) ──────────────────────────────
# NÃO configure client_id/client_secret aqui. Cada streamer informa os
# próprios valores em Configurações → Pagamentos; o app grava em
# public.streamer_configs e gera a URL:
#   https://seu-projeto.vercel.app/api/livepix?streamer=...&secret=...
LIVEPIX_OAUTH_SCOPE=messages:read
